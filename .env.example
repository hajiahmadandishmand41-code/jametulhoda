APP_ENV=
SITE_URL=https://jametulhoda.gt.tc
BASE_PATH=
JHD_PRETTY_URLS=false
SITE_EMAIL=
SITE_PHONE=
SITE_ADDRESS=
# Two-driver database architecture:
#   Vercel        → PostgreSQL/Neon, set DATABASE_URL (DB_* are ignored there).
#   InfinityFree  → MySQL/MariaDB through DB_* (DATABASE_URL stays empty).
DATABASE_URL=
DB_DRIVER=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
SESSION_DRIVER=
# Persistent media storage.
#   local       durable only on a classic host (InfinityFree/VPS). Refused on
#               Vercel: its filesystem is read-only and /tmp is ephemeral.
#   s3          any S3-compatible bucket (needs the S3_* values below AND an
#               absolute https UPLOAD_BASE_URL pointing at the public bucket URL).
#   vercel-blob Vercel Blob store; selected automatically on Vercel as soon as
#               BLOB_READ_WRITE_TOKEN exists. UPLOAD_BASE_URL must then be the
#               store origin, e.g. https://<store>.public.blob.vercel-storage.com
UPLOAD_STORAGE=
UPLOAD_LOCAL_PATH=
UPLOAD_BASE_URL=
# Injected automatically by Vercel when a Blob store is attached to the project.
BLOB_READ_WRITE_TOKEN=
# Only for tests: overrides the Blob API endpoint (default https://blob.vercel-storage.com).
BLOB_API_BASE=
# حداکثر بزرگ‌ترین ضلع تصویرهای ذخیره‌شده (پیش‌فرض 2000 پیکسل)
IMAGE_MAX_EDGE=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=
# Administrator password must be a unique secret of at least 14 characters.
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
# Upload folder names (defaults: audios / videos; legacy audio / video stay readable)
UPLOAD_AUDIO_DIR=
UPLOAD_VIDEO_DIR=
# Token for the idempotent schema bootstrap at /php/migrate (hosts without a
# shell, e.g. Vercel). Leave empty to disable the endpoint entirely.
MIGRATION_TOKEN=
