APP_ENV=
SITE_URL=https://jametulhoda.gt.tc
BASE_PATH=
JHD_PRETTY_URLS=false
SITE_EMAIL=
SITE_PHONE=
SITE_ADDRESS=
# Two-driver database architecture:
#   Vercel        → PostgreSQL/Supabase, set DATABASE_URL (DB_* are ignored there).
#                 On Vercel use Supabase Session Pooler (IPv4) rather than the
#                 direct db.<project-ref>.supabase.co endpoint unless the project
#                 has IPv4 enabled.
#   InfinityFree  → MySQL/MariaDB through DB_* (DATABASE_URL stays empty).
DATABASE_URL=
DB_DRIVER=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
SESSION_DRIVER=
# Persistent media storage.
#   supabase   Production/Vercel primary. Uses Supabase Storage bucket site-media.
#              Server-side credentials are SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
#              Large browser uploads use a signed TUS/resumable grant.
#   local/s3/vercel-blob remain supported for legacy/development and are not removed.
UPLOAD_STORAGE=supabase
UPLOAD_LOCAL_PATH=
UPLOAD_BASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=site-media
SUPABASE_TUS_ENDPOINT=
# Injected automatically by Vercel when a Blob store is attached to the project.
BLOB_READ_WRITE_TOKEN=
# Only for tests: overrides the Blob API endpoint (default https://blob.vercel-storage.com).
BLOB_API_BASE=
# حداکثر بزرگ‌ترین ضلع تصویرهای ذخیره‌شده (پیش‌فرض 2000 پیکسل)
IMAGE_MAX_EDGE=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=
# Administrator password must be a unique secret of at least 14 characters.
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
# Upload folder names (defaults: audios / videos; legacy audio / video stay readable)
UPLOAD_AUDIO_DIR=
UPLOAD_VIDEO_DIR=
# Token for the idempotent schema bootstrap at /php/migrate (hosts without a
# shell, e.g. Vercel). Leave empty to disable the endpoint entirely.
MIGRATION_TOKEN=
